{
	"name": "dashboard",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.19.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev --filter=@dashboard/desktop",
		"dev:web": "turbo run dev --filter=@dashboard/web",
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"lint": "biome check",
		"format": "biome check --write",
		"check": "biome check && turbo run typecheck",
		"db:generate": "npm run db:generate -w @dashboard/platform",
		"install-app": "npm run install-app -w @dashboard/desktop --"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"turbo": "^2.11.13",
		"typescript": "^6.0.2"
	}
}
