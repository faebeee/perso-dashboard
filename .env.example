# Public URL of the app. OAuth callbacks are built from it:
#   {APP_URL}/api/oauth/{github|jira|gmail}/callback
APP_URL=http://127.0.0.1:3100

# 32 random bytes, base64. Used to encrypt OAuth tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# SQLite file (created automatically, migrations run on startup)
DATABASE_PATH=./data/dashboard.db

# --- Integrations: leave a pair empty to hide that integration's "Connect" button ---

# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Atlassian (Jira Cloud) OAuth 2.0 (3LO) app: https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Google OAuth client (Web application): https://console.cloud.google.com/apis/credentials
# Shared by Gmail and Google Calendar. Enable both APIs and register both callbacks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
